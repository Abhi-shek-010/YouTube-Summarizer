{
  "manifest_version": 3,
  "name": "YouTube AI Summarizer",
  "version": "1.0.0",
  "description": "Instantly generates structured AI summaries of YouTube videos.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Summarize this video"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:8000/*"
  ]
}
